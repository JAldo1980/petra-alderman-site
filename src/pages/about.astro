---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { about } from '../content/pages';
---

<Base
  title="About"
  description="Dr Petra Alderman's academic background, positions and qualifications."
>
  <PageHead label="About" title="Author, researcher and policy advisor" />

  <section class="section">
    <div class="wrap split">
      <div><h2>Profile</h2></div>
      <div class="prose">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <p class="actions">
          <a class="more" href="/cv/">View full CV</a>
          <a class="more" href="/contact/">Get in touch</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div><h2>Positions</h2></div>
      <ul class="rows">
        {
          about.positions.map((p) => (
            <li>
              <span class="when">{p.years}</span>
              <span>
                {p.role}
                <span class="sub">{p.place}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div><h2>Qualifications</h2></div>
      <ul class="rows">
        {
          about.qualifications.map((q) => (
            <li>
              <span class="when">{q.year}</span>
              <span>
                {q.title}
                <span class="sub">{q.place}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div><h2>Recognition</h2></div>
      <div class="prose">
        {about.recognition.map((p) => <p>{p}</p>)}
        <ul class="plain" style="margin-top: 1.5rem">
          {
            about.awards.map((a) => (
              <li>
                <strong style="font-weight: 500">{a.title}</strong>, {a.by}
                <span style="display: block; color: var(--muted); font-size: 1.0625rem">{a.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div><h2>Languages</h2></div>
      <ul class="rows">
        {
          about.languages.map((l) => (
            <li>
              <span class="when">{l.level}</span>
              <span>{l.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div><h2>Other activities</h2></div>
      <ul class="plain">
        {about.otherActivities.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>
</Base>
