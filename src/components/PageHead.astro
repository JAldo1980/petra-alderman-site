---
interface Props {
  label?: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---

<header class="page-head">
  <div class="wrap">
    {label && <span class="label">{label}</span>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</header>
